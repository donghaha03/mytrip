rules_version = '2';

// Firebase 콘솔 -> Firestore Database -> 규칙 탭에 이 내용을 그대로 붙여 넣고 "게시".
//
// 로그인한 사람은 자기 users/{uid} 아래만 읽고 쓸 수 있다.
// 남의 여행은 id 를 알아도 못 본다.
//
// ⚠ 콘솔에서 "테스트 모드" 로 만들면 30일 동안 누구나 전부 읽고 쓸 수 있다.
//   웹 API 키는 공개 repo 에 올라가니, 반드시 이 규칙으로 바꿀 것.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
